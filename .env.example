DEBUG=True
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://svc:svc@db:5432/svc_usuarios

# Llaves RS256 de los tokens JWT (T-04/ST-21). Generarlas con: docs/llaves_rs256_sjwt.md
# Ruta relativa a la raíz del proyecto (o absoluta). También acepta el contenido PEM
# en una sola línea, con \n en lugar de los saltos de línea.
JWT_LLAVE_PRIVADA=llaves/privada.pem
JWT_LLAVE_PUBLICA=llaves/publica.pem

# Configuración SMTP - Gmail #T-08/ST-40
EMAIL_HOST=smtp.gmail.com #T-08/ST-40      
EMAIL_PORT=587 #T-08/ST-40  
EMAIL_USE_TLS=True #T-08/ST-40
EMAIL_HOST_USER= #T-08/ST-40 Correo electrónico exclusivo del proyecto.
EMAIL_HOST_PASSWORD= #T-08/ST-40 Contraseña de aplicación generada desde la cuenta de Google.
DEFAULT_FROM_EMAIL= #T-08/ST-40 Dirección que aparecerá como remitente de los correos.

CLAVE_CIFRADO_2FA = #t-30/st_205