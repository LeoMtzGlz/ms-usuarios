# Copia este archivo a .env y ajusta los valores.
# Los comentarios van en su propia línea, arriba de la variable: django-environ lee como
# parte del valor todo lo que va después del "=", incluido un "# comentario".
# Este archivo sí se sube a Git: nunca pongas secretos reales aquí.

DEBUG=True
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://svc:svc@db:5432/svc_usuarios
WHATSAPP_ACCESS_TOKEN=
# Versión vigente del aviso de privacidad; se guarda en cada registro (HU-02/ST-65)
VERSION_AVISO_PRIVACIDAD=1.0
# Igual que docker-compose.yml. Si corres Django fuera de Docker usa localhost:5433
DATABASE_URL=postgres://ms_user:ms_password@db:5432/ms_usuarios



# Llaves RS256 de los tokens JWT (T-04/ST-21). Generarlas con: docs/llaves_rs256_sjwt.md
# Ruta relativa a la raíz del proyecto (o absoluta). También acepta el contenido PEM
# en una sola línea, con \n en lugar de los saltos de línea.
JWT_LLAVE_PRIVADA=llaves/privada.pem
JWT_LLAVE_PUBLICA=llaves/publica.pem

# Configuración SMTP - Gmail #T-08/ST-40
# Correo (T-08/ST-41). Con Gmail usa una contraseña de aplicación, no la de la cuenta.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Correo electrónico exclusivo del proyecto.
EMAIL_HOST_USER=
# Contraseña de aplicación generada desde la cuenta de Google.
EMAIL_HOST_PASSWORD=
# Dirección que aparecerá como remitente de los correos.
DEFAULT_FROM_EMAIL=

# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# t-30/st-205
CLAVE_CIFRADO_2FA=

CANAL_NOTIFICACIONES=consola


# t-29/st-200: aviso de privacidad. Versión vigente (año-mes) y URL pública del documento
VERSION_AVISO_PRIVACIDAD=2026-10
URL_AVISO_PRIVACIDAD=


# t-22/st-167: IPs de los proxies propios, separadas por comas (vacío = no hay proxy, se usa REMOTE_ADDR)
PROXIES_CONFIABLES=


# t-33/st-218: ID de cliente OAuth de Google (tipo "Aplicación web"). Cómo crearlo: docs/HU-33/ST-218-credenciales-google.md
# Termina en .apps.googleusercontent.com. El secreto del cliente NO se usa ni se guarda aquí.
GOOGLE_CLIENT_ID=